{
  "framework": "nextjs",
  "functions": {
    "app/api/queues/lab-results/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "pay-lab-results" }]
    }
  },
  "git": {
    "deploymentEnabled": {
      "codex/partner-reference-lab": false,
      "codex/phase2-canonical": false,
      "codex/reconcile-session-api-source": false
    }
  },
  "env": {
    "PAY_LAB_DEPLOYMENT_MODE": "canonical",
    "PAY_LAB_ENVIRONMENT": "staging",
    "PAY_LAB_QUEUE_ENABLED": "true"
  }
}
